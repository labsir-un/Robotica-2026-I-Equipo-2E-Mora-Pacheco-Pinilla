<?xml version="1.0"?>
<robot name="phantomx_pincher" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="use_meshes" default="true"/>

  <xacro:property name="PI" value="3.141592653589793"/>
  <xacro:property name="ax12_height" value="0.032"/>
  <xacro:property name="ax12_width" value="0.038"/>
  <xacro:property name="f2_height" value="0.0265"/>
  <xacro:property name="f4_height" value="0.0525"/>
  <xacro:property name="f10_height" value="0.004"/>
  <xacro:property name="finger_centre_offset_x" value="0.019"/>
  <xacro:property name="finger_centre_offset_y" value="0.0115"/>

  <xacro:property name="L1" value="0.0445"/>
  <xacro:property name="L2" value="0.1010"/>
  <xacro:property name="L3" value="0.1010"/>
  <xacro:property name="L4" value="0.1190"/>
  <xacro:property name="Lm" value="0.0"/>

  <material name="black"><color rgba="0 0 0 1"/></material>
  <material name="gray"><color rgba="0.5 0.5 0.5 1"/></material>
  <material name="white"><color rgba="1 1 1 1"/></material>
  <material name="yellow"><color rgba="1 1 0 1"/></material>
  <material name="green"><color rgba="0 1 0 1"/></material>
  <material name="red"><color rgba="1 0 0 1"/></material>
  <material name="blue"><color rgba="0 0 1 1"/></material>
  <material name="purple"><color rgba="0.5 0 0.5 1"/></material>
  <material name="pincher_black"><color rgba="0.15 0.15 0.15 1.0"/></material>

  <xacro:macro name="dae_mesh" params="mesh mesh_xyz mesh_rpy">
    <xacro:if value="$(arg use_meshes)">
      <visual>
        <origin xyz="${mesh_xyz}" rpy="${mesh_rpy}"/>
        <geometry>
          <mesh filename="package://pincher_description/meshes/visual/${mesh}.dae"/>
        </geometry>
        <material name="pincher_black"/>
      </visual>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="stl_mesh" params="mesh mesh_xyz mesh_rpy">
    <xacro:if value="$(arg use_meshes)">
      <visual>
        <origin xyz="${mesh_xyz}" rpy="${mesh_rpy}"/>
        <geometry>
          <mesh filename="package://pincher_description/meshes/STL/${mesh}.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="pincher_black"/>
      </visual>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="box_visual" params="box_size box_xyz box_rpy">
    <xacro:unless value="$(arg use_meshes)">
      <visual>
        <origin xyz="${box_xyz}" rpy="${box_rpy}"/>
        <geometry>
          <box size="${box_size}"/>
        </geometry>
        <material name="pincher_black"/>
      </visual>
    </xacro:unless>
  </xacro:macro>

  <link name="world"/>

  <joint name="joint_world" type="fixed">
    <parent link="world"/>
    <child link="link0"/>
  </joint>

  <link name="link0">
    <xacro:stl_mesh mesh="caseBaseRobot" mesh_xyz="0 0 0" mesh_rpy="${PI} 0 ${PI/2}"/>
    <xacro:box_visual box_size="0.066 0.074 0.048" box_xyz="0 0 0.024" box_rpy="0 0 0"/>
  </link>

  <joint name="waist" type="revolute">
    <origin xyz="0.0 0.0 ${0.08945-L1}" rpy="0.0 0.0 0.0"/>
    <parent link="link0"/>
    <child link="link1"/>
    <axis xyz="0.0 0.0 1.0"/>
    <limit lower="${-150*PI/180}" upper="${150*PI/180}" effort="4.0" velocity="2.0"/>
  </joint>

  <link name="link1">
    <xacro:dae_mesh mesh="ax12" mesh_xyz="0 0 0" mesh_rpy="${PI/2} 0 ${PI/2}"/>
    <xacro:dae_mesh mesh="f3" mesh_xyz="0 ${ax12_width/2} 0" mesh_rpy="${-PI/2} ${PI/2} ${PI}"/>
    <xacro:box_visual box_size="0.065 0.065 0.070" box_xyz="0 0 0.015" box_rpy="0 0 0"/>
  </link>

  <joint name="shoulder" type="revolute">
    <origin xyz="0.0 0.0 ${L1}" rpy="${-PI/2} 0.0 0.0"/>
    <parent link="link1"/>
    <child link="link2"/>
    <axis xyz="0.0 0.0 -1.0"/>
    <limit lower="${-150*PI/180}" upper="${150*PI/180}" effort="4.0" velocity="2.0"/>
  </joint>

  <link name="link2">
    <xacro:dae_mesh mesh="ax12" mesh_xyz="0 0 ${-ax12_height-f10_height+0.001}" mesh_rpy="0 ${PI} 0"/>
    <xacro:dae_mesh mesh="f4" mesh_xyz="0 0 0" mesh_rpy="0 0 0"/>
    <xacro:box_visual box_size="0.045 ${L2} 0.045" box_xyz="${Lm/2} ${-L2/2} 0" box_rpy="0 0 0"/>
  </link>

  <joint name="elbow" type="revolute">
    <origin xyz="${Lm} ${-L2} 0.0" rpy="0.0 0.0 ${-atan2(L2,Lm)-PI/2}"/>
    <parent link="link2"/>
    <child link="link3"/>
    <axis xyz="0.0 0.0 -1.0"/>
    <limit lower="${-150*PI/180}" upper="${150*PI/180}" effort="4.0" velocity="2.0"/>
  </joint>

  <link name="link3">
    <xacro:dae_mesh mesh="ax12" mesh_xyz="0 0 ${-ax12_height-f10_height+0.001}" mesh_rpy="0 ${PI} 0"/>
    <xacro:dae_mesh mesh="f4" mesh_xyz="0 0 0" mesh_rpy="0 0 0"/>
    <xacro:box_visual box_size="${L3} 0.040 0.040" box_xyz="${L3/2} 0 0" box_rpy="0 0 0"/>
  </link>

  <joint name="wrist" type="revolute">
    <origin xyz="${L3*cos(atan2(L2,Lm))} ${L3*sin(atan2(L2,Lm))} 0.0" rpy="0.0 0.0 ${atan2(L2,Lm)}"/>
    <parent link="link3"/>
    <child link="link4"/>
    <axis xyz="0.0 0.0 -1.0"/>
    <limit lower="${-150*PI/180}" upper="${150*PI/180}" effort="4.0" velocity="2.0"/>
  </joint>

  <link name="link4">
    <xacro:dae_mesh mesh="ax12" mesh_xyz="0 0 ${-ax12_width/2}" mesh_rpy="${PI/2} ${PI} ${PI/2}"/>
    <xacro:dae_mesh mesh="f2" mesh_xyz="0 0 0" mesh_rpy="0 0 0"/>
    <xacro:dae_mesh mesh="gripper_base" mesh_xyz="0 0 0" mesh_rpy="0 0 0"/>
    <xacro:box_visual box_size="${L4} 0.055 0.050" box_xyz="${L4/2} 0 0" box_rpy="0 0 0"/>
  </link>

  <joint name="joint4" type="fixed">
    <origin xyz="${L4} 0.0 0.0" rpy="${-PI/2} 0.0 ${-PI/2}"/>
    <parent link="link4"/>
    <child link="gripper_bar"/>
  </joint>

  <link name="gripper_bar">
    <xacro:box_visual box_size="0.075 0.020 0.018" box_xyz="0.035 0 0" box_rpy="0 0 0"/>
  </link>

  <joint name="gripper" type="revolute">
    <origin xyz="0.066 0.0 0.0" rpy="0.0 ${PI/2} 0.0"/>
    <parent link="link4"/>
    <child link="prop"/>
    <axis xyz="0.0 0.0 1.0"/>
    <limit lower="${-PI/2}" upper="${PI/2}" effort="2.0" velocity="1.0"/>
  </joint>

  <link name="prop">
    <xacro:box_visual box_size="0.025 0.025 0.050" box_xyz="0 0 -0.025" box_rpy="0 0 0"/>
  </link>

  <joint name="joint6" type="prismatic">
    <origin xyz="0.0 0.0 ${0.08605-L4}" rpy="0.0 ${PI/2} 0.0"/>
    <parent link="gripper_bar"/>
    <child link="finger_1"/>
    <axis xyz="0.0 1.0 0.0"/>
    <limit lower="-0.04" upper="-0.015" effort="2.0" velocity="0.05"/>
    <mimic joint="gripper" multiplier="-0.008" offset="-0.0265"/>
  </joint>

  <link name="finger_1">
    <xacro:dae_mesh mesh="finger" mesh_xyz="0 0 0" mesh_rpy="0 0 0"/>
    <xacro:box_visual box_size="0.070 0.012 0.015" box_xyz="0.035 0 0" box_rpy="0 0 0"/>
  </link>

  <joint name="joint7" type="prismatic">
    <origin xyz="0.0 0.0 ${0.08605-L4}" rpy="0.0 ${PI/2} ${PI}"/>
    <parent link="gripper_bar"/>
    <child link="finger_2"/>
    <axis xyz="0.0 1.0 0.0"/>
    <limit lower="-0.04" upper="-0.015" effort="2.0" velocity="0.05"/>
    <mimic joint="joint6" multiplier="1.0" offset="0.0"/>
  </joint>

  <link name="finger_2">
    <xacro:dae_mesh mesh="finger" mesh_xyz="0 0 0" mesh_rpy="0 0 0"/>
    <xacro:box_visual box_size="0.070 0.012 0.015" box_xyz="0.035 0 0" box_rpy="0 0 0"/>
  </link>
</robot>
